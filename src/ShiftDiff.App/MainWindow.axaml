<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ShiftDiff.App"
        x:Class="ShiftDiff.App.MainWindow"
        Title="ShiftDiff — semantic comparison workspace"
        Width="1560"
        Height="960"
        MinWidth="1040"
        MinHeight="680"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
  <Grid RowDefinitions="Auto,Auto,2*,6,3*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,9">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Background="#6F5BE7" CornerRadius="6" Padding="8,5">
            <TextBlock Text="SD" Foreground="White" FontWeight="Bold" />
          </Border>
          <StackPanel>
            <TextBlock Text="ShiftDiff" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Files, folders and interactive merge" FontSize="11" Opacity="0.65" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Content="Files…" ToolTip.Tip="Start a 2–4 file comparison" Click="OnOpenFiles" />
          <Button Content="Folders…" ToolTip.Tip="Start a 2–4 folder comparison" Click="OnOpenFolders" />
          <Button Content="Recompare" Click="OnRecompare" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
          <Button Content="Previous" Click="OnPreviousChange" />
          <Button Content="Next" Click="OnNextChange" />
          <Separator Width="1" Margin="5,2" />
          <Button Content="Undo merge" Click="OnUndoMerge" />
          <Button Content="Export target…" Classes="accent" Click="OnExportTarget" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="Theme" Margin="0,0,5,0" Opacity="0.65" VerticalAlignment="Center" />
          <Button Content="Light" Click="OnLightTheme" Padding="8,4" />
          <Button Content="System" Click="OnSystemTheme" Padding="8,4" />
          <Button Content="Dark" Click="OnDarkTheme" Padding="8,4" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,7"
            DragDrop.AllowDrop="True">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="SOURCES" FontSize="11" FontWeight="Bold" Opacity="0.55" VerticalAlignment="Center" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Panes}" Margin="14,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding AccentBackground}" CornerRadius="5" Padding="9,5" MaxWidth="330">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding Ordinal}" FontWeight="Bold" Foreground="{Binding AccentForeground}" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RootPath}" Opacity="0.58" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="WhitespaceSelector" Width="125" />
          <ComboBox x:Name="DetectionSelector" Width="120" />
          <CheckBox x:Name="IgnoreCaseCheck" Content="Ignore case" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Margin="10,10,10,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <Grid RowDefinitions="Auto,*">
        <Grid Margin="10,7" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="FOLDER VIEW" FontSize="11" FontWeight="Bold" Opacity="0.55" />
            <TextBlock x:Name="FolderSummaryText" Text="Drop or open two to four folders/files" Opacity="0.75" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Purple: moved folder · Green: moved file · Amber: moved + edited" FontSize="11" Opacity="0.55" />
        </Grid>

        <Grid Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Panes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,1,0">
                  <Grid RowDefinitions="Auto,*">
                    <Border Background="{Binding AccentBackground}" Padding="9,5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding FolderChangeCount}" Opacity="0.65" />
                      </Grid>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FolderRows}"
                             SelectedItem="{Binding SelectedFolderRow}"
                             SelectionChanged="OnFolderSelectionChanged"
                             BorderThickness="0"
                             Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{Binding Background}" Padding="8,4" MinHeight="25">
                            <Grid ColumnDefinitions="24,*,Auto">
                              <TextBlock Text="{Binding Icon}" Opacity="0.75" />
                              <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusForeground}" Margin="8,0,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <local:RelationshipLayer x:Name="FolderRelationshipLayer" IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

    <Grid Grid.Row="4" Margin="10,0,10,10" ColumnDefinitions="*,330" ColumnSpacing="8">
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="10,7" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="FILE / BLOCK VIEW" FontSize="11" FontWeight="Bold" Opacity="0.55" />
              <TextBlock x:Name="FileSummaryText" Text="Select a file above" Opacity="0.75" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Select a source line, then insert or replace its semantic block" FontSize="11" Opacity="0.55" />
          </Grid>

          <Grid Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Panes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                      <Border Background="{Binding AccentBackground}" Padding="8,5">
                        <TextBlock Text="{Binding SelectedPath}" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                      </Border>
                      <ListBox Grid.Row="1"
                               ItemsSource="{Binding Lines}"
                               SelectedItem="{Binding SelectedLine}"
                               BorderThickness="0"
                               Background="Transparent">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{Binding Background}" Padding="4,2" MinHeight="22">
                              <Grid ColumnDefinitions="24,42,*">
                                <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerForeground}" HorizontalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Number}" HorizontalAlignment="Right" Margin="0,0,8,0" Opacity="0.48" FontFamily="monospace" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Border Grid.Row="2" Padding="6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                          <TextBlock Text="{Binding SelectedBlockLabel}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,5,0" />
                          <Button Content="Insert block →" Click="OnInsertBlock" Padding="7,3" />
                          <Button Content="Replace target →" Click="OnReplaceBlock" Padding="7,3" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <local:RelationshipLayer x:Name="BlockRelationshipLayer" IsHitTestVisible="False" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Padding="10,7" Background="{DynamicResource SystemControlHighlightAccentBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="MERGE TARGET" FontSize="11" FontWeight="Bold" />
                <TextBlock x:Name="TargetPathText" Text="Reconstructed result" FontFamily="monospace" Opacity="0.72" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="editable by blocks" VerticalAlignment="Center" Opacity="0.65" />
            </Grid>
          </Border>
          <ListBox x:Name="MergeTargetList" Grid.Row="1" ItemsSource="{Binding MergeLines}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding Background}" Padding="5,2" MinHeight="22">
                  <Grid ColumnDefinitions="42,*">
                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Right" Margin="0,0,8,0" Opacity="0.48" FontFamily="monospace" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock x:Name="MergeStatusText" Text="No merge edits" Opacity="0.65" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="5"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="Ready — open or drop two to four files/folders" Opacity="0.72" />
        <ProgressBar x:Name="BusyIndicator" Grid.Column="1" Width="130" IsIndeterminate="True" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>

