<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ShiftDiff.App.Controls"
        x:Class="ShiftDiff.App.MainWindow"
        Title="ShiftDiff"
        Width="1600"
        Height="980"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource ShellBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="F7" Command="{Binding $self.PreviousChangeCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding $self.NextChangeCommand}" />
    <KeyBinding Gesture="Shift+F8" Command="{Binding $self.NextConflictCommand}" />
    <KeyBinding Gesture="Ctrl+F8" Command="{Binding $self.NextMovedCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding $self.JumpToPairCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding $self.RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding $self.FocusSearchCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding $self.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding $self.ZoomOutCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Toolbar ======================================================== -->
    <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" Padding="14,9"
            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="8,4">
            <TextBlock Text="SD" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="ShiftDiff" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="SessionTitleText" Text="Semantic comparison" Classes="muted" FontSize="11"
                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
          </StackPanel>

          <Rectangle Width="1" Height="26" Fill="{DynamicResource BorderBrushColor}" Margin="6,0" />

          <Button Content="Open pair…" Click="OnOpenPair" ToolTip.Tip="Compare two files" />
          <Button Content="Folders…" Click="OnOpenFolders" ToolTip.Tip="Compare two folders" />
          <Button Content="Repository…" Click="OnOpenRepository" ToolTip.Tip="Open a Git or SVN working copy" />
          <Button x:Name="SwapButton" Content="Swap" Command="{Binding $parent[Window].SwapCommand}" ToolTip.Tip="Swap the two sides" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" VerticalAlignment="Center">
          <Button Classes="icon" Content="⏮" Click="OnFirstChange" ToolTip.Tip="First change" />
          <Button Classes="icon" Content="▲" Click="OnPreviousChange" ToolTip.Tip="Previous change (F7)" />
          <Button Classes="icon" Content="▼" Click="OnNextChange" ToolTip.Tip="Next change (F8)" />
          <Button Classes="icon" Content="⏭" Click="OnLastChange" ToolTip.Tip="Last change" />
          <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrushColor}" Margin="4,0" />
          <Button Classes="icon" Content="⚠" Click="OnNextConflict" ToolTip.Tip="Next conflict (Shift+F8)" />
          <Button Classes="icon" Content="⇅" Click="OnNextMoved" ToolTip.Tip="Next moved block (Ctrl+F8)" />
          <Button Classes="icon" Content="⇄" Click="OnJumpToPair" ToolTip.Tip="Jump to the paired moved block (Ctrl+P)" />
          <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrushColor}" Margin="4,0" />
          <TextBox x:Name="SearchBox" Width="180" PlaceholderText="Search in diff…" KeyUp="OnSearchChanged" />
          <ComboBox x:Name="FilterSelector" Width="130" SelectionChanged="OnFilterChanged"
                    ToolTip.Tip="Filter by change type" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ComboBox x:Name="LayoutSelector" Width="120" SelectionChanged="OnLayoutChanged" ToolTip.Tip="Pane layout" />
          <ComboBox x:Name="ThemeSelector" Width="95" SelectionChanged="OnThemeChanged" />
          <Button Content="Export patch…" Click="OnExportPatch" ToolTip.Tip="Write a unified diff for this comparison" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Options bar ==================================================== -->
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="14,7"
            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
            DragDrop.AllowDrop="True">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <TextBlock Text="COMPARE" Classes="caption" VerticalAlignment="Center" />
            <ComboBox x:Name="DetectionSelector" Width="118" SelectionChanged="OnDetectionChanged"
                      ToolTip.Tip="Semantic detection aggressiveness" />
            <ComboBox x:Name="WhitespaceSelector" Width="118" SelectionChanged="OnWhitespaceChanged"
                      ToolTip.Tip="Whitespace handling" />
            <CheckBox x:Name="IgnoreCaseCheck" Content="Case" IsCheckedChanged="OnIgnoreCaseChanged"
                      ToolTip.Tip="Ignore case differences" />
            <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrushColor}" />
            <TextBlock Text="VIEW" Classes="caption" VerticalAlignment="Center" />
            <CheckBox x:Name="CollapseCheck" Content="Fold" IsCheckedChanged="OnCollapseChanged"
                      ToolTip.Tip="Fold unchanged regions" />
            <CheckBox x:Name="SyntaxCheck" Content="Syntax" IsCheckedChanged="OnSyntaxChanged"
                      ToolTip.Tip="Syntax colouring" />
            <CheckBox x:Name="EmojiCheck" Content="Emoji" IsCheckedChanged="OnEmojiChanged"
                      ToolTip.Tip="Emoji change markers" />
            <CheckBox x:Name="WrapCheck" Content="Wrap" IsCheckedChanged="OnWrapChanged"
                      ToolTip.Tip="Wrap long lines" />
            <CheckBox x:Name="ContrastCheck" Content="Contrast" IsCheckedChanged="OnContrastChanged"
                      ToolTip.Tip="High contrast fills" />
            <CheckBox x:Name="SidebarCheck" Content="Files" IsCheckedChanged="OnSidebarChanged"
                      ToolTip.Tip="File list sidebar" />
            <CheckBox x:Name="InspectorCheck" Content="Inspector" IsCheckedChanged="OnInspectorChanged" />
            <Button Classes="icon" Content="A-" Click="OnZoomOut" ToolTip.Tip="Smaller text (Ctrl+-)" />
            <Button Classes="icon" Content="A+" Click="OnZoomIn" ToolTip.Tip="Larger text (Ctrl++)" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Margin="12,0,0,0">
          <StackPanel x:Name="RevisionBar" Orientation="Horizontal" Spacing="6" IsVisible="False">
            <TextBlock Text="REVISIONS" Classes="caption" VerticalAlignment="Center" />
            <TextBox x:Name="FromRevisionBox" Width="110" PlaceholderText="from" KeyUp="OnRevisionKeyUp" />
            <TextBlock Text="→" VerticalAlignment="Center" Classes="muted" />
            <TextBox x:Name="ToRevisionBox" Width="110" PlaceholderText="to" KeyUp="OnRevisionKeyUp" />
            <Button Content="Compare" Click="OnCompareRevisions" />
          </StackPanel>
          <TextBlock x:Name="DropHintText" Classes="muted" VerticalAlignment="Center"
                     Text="Drop 1–4 files, folders or a repository" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content ======================================================== -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">

      <!-- File list sidebar -->
      <Border x:Name="SidebarPanel" Width="270" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="12,10,12,8" Spacing="6">
            <TextBlock Text="FILES" Classes="caption" />
            <TextBox x:Name="FileFilterBox" PlaceholderText="Filter files…" KeyUp="OnFileFilterChanged" />
          </StackPanel>
          <ListBox Grid.Row="1" x:Name="FileList" Background="Transparent" BorderThickness="0"
                   SelectionChanged="OnFileSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="20,*" Margin="0,2">
                  <TextBlock Classes="marker"
                             Classes.added="{Binding IsAdded}"
                             Text="{Binding Marker}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Diff panes -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="0,0,0,1" Padding="0,6">
          <Grid ColumnDefinitions="34,*">
            <TextBlock Text="" />
            <ItemsControl Grid.Column="1" x:Name="PaneHeaders">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1,0,0,0" Padding="10,0">
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Panel Grid.Row="1">
        <ListBox x:Name="DiffList" Classes="diff" SelectionChanged="OnRowSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="34,*">

                <!-- change marker gutter -->
                <Border Background="{DynamicResource GutterBrush}" Padding="0,1">
                  <Panel>
                    <TextBlock Classes="marker"
                               Classes.added="{Binding IsAdded}"
                               Classes.removed="{Binding IsRemoved}"
                               Classes.edited="{Binding IsEdited}"
                               Classes.moved="{Binding IsMoved}"
                               Classes.conflict="{Binding IsConflict}"
                               Text="{Binding EmojiMarker}"
                               IsVisible="{Binding $parent[Window].UseEmojiMarkers}"
                               ToolTip.Tip="{Binding Label}" />
                    <TextBlock Classes="marker"
                               Classes.added="{Binding IsAdded}"
                               Classes.removed="{Binding IsRemoved}"
                               Classes.edited="{Binding IsEdited}"
                               Classes.moved="{Binding IsMoved}"
                               Classes.conflict="{Binding IsConflict}"
                               Text="{Binding Marker}"
                               IsVisible="{Binding !$parent[Window].UseEmojiMarkers}"
                               ToolTip.Tip="{Binding Label}" />
                  </Panel>
                </Border>

                <!-- folded region -->
                <Border Grid.Column="1" IsVisible="{Binding IsCollapsed}"
                        Background="{DynamicResource GutterBrush}" Padding="10,3"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,1">
                  <TextBlock Text="{Binding CollapsedText}" Classes="muted" HorizontalAlignment="Center" FontSize="11" />
                </Border>

                <!-- panes -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" IsVisible="{Binding IsLine}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="cell"
                              Classes.added="{Binding IsAdded}"
                              Classes.removed="{Binding IsRemoved}"
                              Classes.edited="{Binding IsEdited}"
                              Classes.moved="{Binding IsMoved}"
                              Classes.conflict="{Binding IsConflict}"
                              Classes.empty="{Binding IsEmpty}"
                              Classes.lastpane="{Binding IsLastPane}">
                        <Grid ColumnDefinitions="52,*">
                          <Border Classes="linegutter">
                            <TextBlock Classes="linenumber" Text="{Binding LineNumberText}" Margin="0,1,7,1" />
                          </Border>

                          <!-- Araxis-style block box: the outline is drawn once
                               around the whole run of changed rows. -->
                          <Border Grid.Column="1" Classes="blockbox"
                                  Classes.added="{Binding IsAdded}"
                                  Classes.removed="{Binding IsRemoved}"
                                  Classes.edited="{Binding IsEdited}"
                                  Classes.moved="{Binding IsMoved}"
                                  Classes.conflict="{Binding IsConflict}"
                                  Classes.single="{Binding IsBlockSingle}"
                                  Classes.first="{Binding IsBlockFirst}"
                                  Classes.mid="{Binding IsBlockMiddle}"
                                  Classes.last="{Binding IsBlockLast}">
                            <Grid ColumnDefinitions="*,Auto">
                              <ItemsControl ItemsSource="{Binding Segments}" Margin="3,1,0,1">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Classes="run"
                                            Classes.added="{Binding IsAdded}"
                                            Classes.removed="{Binding IsRemoved}">
                                      <TextBlock Classes="seg"
                                                 Classes.keyword="{Binding IsKeyword}"
                                                 Classes.str="{Binding IsString}"
                                                 Classes.comment="{Binding IsComment}"
                                                 Classes.number="{Binding IsNumber}"
                                                 Classes.op="{Binding IsOperator}"
                                                 Text="{Binding Text}" />
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <!-- In-place transfer: copies this block into the
                                   reconstructed result (FR-047). -->
                              <Button Grid.Column="1" Classes="transfer"
                                      Content="{Binding TransferGlyph}"
                                      IsVisible="{Binding CanTransfer}"
                                      ToolTip.Tip="{Binding TransferTip}"
                                      Click="OnTransferBlock" />
                            </Grid>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

          <controls:RelationshipLayer x:Name="Relationships" Margin="34,0,0,0" IsHitTestVisible="False" />

          <Border x:Name="EmptyState" Classes="card" Padding="28,22" HorizontalAlignment="Center"
                  VerticalAlignment="Center" MaxWidth="520">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="Nothing to compare yet" FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                         Text="Drop two files for a side-by-side comparison, three or four for a merge view, two folders to compare trees, or a working copy to open its repository changes." />
              <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Center"
                         Text="F8 next change · Shift+F8 next conflict · Ctrl+F8 next moved block · Ctrl+P jump to pair" />
            </StackPanel>
          </Border>
        </Panel>
      </Grid>

      <!-- Overview bar -->
      <controls:OverviewBar Grid.Column="2" x:Name="Overview" Width="16"
                            ToolTip.Tip="Overview of every change in the file — click to jump" />

      <!-- Inspector -->
      <Border Grid.Column="3" x:Name="InspectorPanel" Width="300" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
          <StackPanel Margin="14,12,14,8" Spacing="4">
            <TextBlock Text="ANALYSIS" Classes="caption" />
            <TextBlock x:Name="LanguageText" Text="—" />
            <TextBlock x:Name="SummaryText" Text="Choose two files to begin." Classes="muted" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1" Classes="card" Margin="12,0,12,10" Padding="12,10">
            <StackPanel Spacing="4">
              <TextBlock x:Name="DetailTitleText" Text="No selection" FontWeight="SemiBold" />
              <TextBlock x:Name="DetailSubtitleText" Text="Select a line to inspect it" Classes="muted"
                         FontSize="11" TextWrapping="Wrap" />
              <ItemsControl x:Name="DetailEntries" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="118,*" Margin="0,2">
                      <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="2" x:Name="ResolvePanel" Margin="12,0,12,8" Spacing="6">
            <TextBlock Text="RESOLVE" Classes="caption" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="TakeLeftButton" Content="◀ Take left" Click="OnTakeLeftBlock"
                      ToolTip.Tip="Replace the selected block in the result with the left pane's version" />
              <Button x:Name="TakeRemoteButton" Content="Take remote ▶" Click="OnTakeRemoteBlock" IsVisible="False"
                      ToolTip.Tip="Replace the selected block in the result with the remote pane's version" />
              <Button Content="↶ Undo" Click="OnUndoMerge" ToolTip.Tip="Undo the last resolve action" />
              <Button Content="Save…" Classes="accent" Click="OnSaveMerged"
                      ToolTip.Tip="Write the reconstructed result to a file" />
            </StackPanel>
            <TextBlock x:Name="MergeStateText" Classes="muted" FontSize="11" Text="Result matches the right file" />
          </StackPanel>

          <TextBlock Grid.Row="3" Text="MOVED BLOCKS" Classes="caption" Margin="14,2,14,6" />

          <ListBox Grid.Row="4" x:Name="MovedBlocksList" Background="Transparent" BorderThickness="0"
                   Margin="6,0,6,6" SelectionChanged="OnMovedBlockSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Padding="10,8" Margin="4,3">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource MovedAccentBrush}" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding ScoreText}" Classes="muted" FontSize="11" />
                    </Grid>
                    <TextBlock Text="{Binding Range}" Classes="muted" FontSize="11" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar ===================================================== -->
    <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="ChangePositionText" Text="no changes" Classes="muted" Margin="0,0,14,0" />
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready" Classes="muted"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsVisible="False" Margin="0,0,8,0" />
        <ProgressBar Grid.Column="3" x:Name="BusyIndicator" Width="120" IsIndeterminate="True" IsVisible="False" />
        <TextBlock Grid.Column="4" x:Name="ZoomText" Text="13 px" Classes="muted" Margin="14,0,0,0" />
        <TextBlock Grid.Column="5" x:Name="ModeText" Text="Balanced" Classes="muted" Margin="14,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
