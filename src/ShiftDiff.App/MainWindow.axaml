<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShiftDiff.App.MainWindow"
        Title="ShiftDiff"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Background="#101318">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Background="#171B22" Padding="16,12" BorderBrush="#2A303A" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="#6857E5" CornerRadius="7" Padding="9,5">
            <TextBlock Text="SD" FontSize="16" FontWeight="Bold" Foreground="White" />
          </Border>
          <StackPanel Spacing="0">
            <TextBlock Text="ShiftDiff" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Semantic source comparison" Foreground="#8D98A8" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button Content="Previous" Click="OnPreviousChange" />
          <Button Content="Next" Click="OnNextChange" />
          <Button Content="Swap" Click="OnSwap" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="ThemeSelector" Width="100" SelectionChanged="OnThemeChanged" />
          <Button Content="Compare" Classes="accent" Click="OnCompare" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#13171D" Padding="16,12" BorderBrush="#2A303A" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,12,*,Auto" RowDefinitions="Auto,Auto">
        <Grid Grid.Column="0" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="OLD" FontSize="11" FontWeight="Bold" Foreground="#D97882" />
            <TextBlock x:Name="OldPathText" Text="Drop or open the original file" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Content="Open…" Click="OnOpenOld" />
        </Grid>

        <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="NEW" FontSize="11" FontWeight="Bold" Foreground="#66C58A" />
            <TextBlock x:Name="NewPathText" Text="Drop or open the changed file" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Content="Open…" Click="OnOpenNew" />
        </Grid>

        <StackPanel Grid.Column="3" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
          <ComboBox x:Name="WhitespaceSelector" Width="125" />
          <ComboBox x:Name="DetectionSelector" Width="120" />
          <CheckBox x:Name="IgnoreCaseCheck" Content="Ignore case" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                Padding="12,7" CornerRadius="6" BorderBrush="#4C5564" BorderThickness="1"
                DragDrop.AllowDrop="True">
          <TextBlock Text="Drop two source files anywhere here — C#, Perl, Python, PHP, Go, Rust, C/C++, VB, Ruby and more"
                     HorizontalAlignment="Center" Foreground="#8D98A8" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,280">
      <Border BorderBrush="#2A303A" BorderThickness="0,0,1,0">
        <ListBox x:Name="DiffList" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="42,48,*,1,42,48,*" MinHeight="24">
                <Border Grid.Column="0" Background="{Binding GutterBackground}" Padding="5,3">
                  <TextBlock Text="{Binding Marker}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{Binding MarkerForeground}" />
                </Border>
                <Border Grid.Column="1" Background="{Binding OldBackground}" Padding="5,3">
                  <TextBlock Text="{Binding OldLineNumber}" HorizontalAlignment="Right" Foreground="#6F7A89" FontFamily="monospace" />
                </Border>
                <Border Grid.Column="2" Background="{Binding OldBackground}" Padding="8,3">
                  <TextBlock Text="{Binding OldLine}" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border Grid.Column="3" Background="#343B46" />
                <Border Grid.Column="4" Background="{Binding GutterBackground}" Padding="5,3">
                  <TextBlock Text="{Binding Marker}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{Binding MarkerForeground}" />
                </Border>
                <Border Grid.Column="5" Background="{Binding NewBackground}" Padding="5,3">
                  <TextBlock Text="{Binding NewLineNumber}" HorizontalAlignment="Right" Foreground="#6F7A89" FontFamily="monospace" />
                </Border>
                <Border Grid.Column="6" Background="{Binding NewBackground}" Padding="8,3">
                  <TextBlock Text="{Binding NewLine}" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Background="#151920" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel>
            <TextBlock Text="ANALYSIS" FontSize="11" FontWeight="Bold" Foreground="#8D98A8" />
            <TextBlock x:Name="LanguageText" Text="Language: —" Margin="0,5,0,0" />
            <TextBlock x:Name="SummaryText" Text="Choose two files to begin." TextWrapping="Wrap" Foreground="#AAB3C0" Margin="0,5,0,12" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="MOVED BLOCKS" FontSize="11" FontWeight="Bold" Foreground="#8D98A8" Margin="0,5,0,6" />
          <ListBox Grid.Row="2" x:Name="MovedBlocksList" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#202630" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#B6A8FF" />
                    <TextBlock Text="{Binding Detail}" Foreground="#8D98A8" FontSize="11" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#171B22" BorderBrush="#2A303A" BorderThickness="0,1,0,0" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#8D98A8" />
        <ProgressBar x:Name="BusyIndicator" Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
