<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Chrome  -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
    <Setter Property="TransparencyLevelHint" Value="None" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,4" />
  </Style>

  <Style Selector="ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- Diff rows  -->
  <Style Selector="ListBox.diff">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.diff ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The cells paint their own backgrounds, so the selected row is marked with
       rules above and below rather than a fill that would hide the change colour. -->
  <Style Selector="ListBox.diff ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
  </Style>

  <Style Selector="ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <!-- Every pane but the last reserves a gutter on its right for the linking
       ribbons the RelationshipLayer draws.  -->
  <Style Selector="Border.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="0,0,38,0" />
  </Style>

  <Style Selector="Border.cell.lastpane">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Araxis-style block outline: one box around each run of changed rows.  -->
  <Style Selector="Border.blockbox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>

  <Style Selector="Border.blockbox.single">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Border.blockbox.first">
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="3,3,0,0" />
  </Style>

  <Style Selector="Border.blockbox.mid">
    <Setter Property="BorderThickness" Value="1,0,1,0" />
  </Style>

  <Style Selector="Border.blockbox.last">
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="CornerRadius" Value="0,0,3,3" />
  </Style>

  <Style Selector="Border.blockbox.added">
    <Setter Property="BorderBrush" Value="{DynamicResource AddedAccentBrush}" />
  </Style>

  <Style Selector="Border.blockbox.removed">
    <Setter Property="BorderBrush" Value="{DynamicResource RemovedAccentBrush}" />
  </Style>

  <Style Selector="Border.blockbox.edited">
    <Setter Property="BorderBrush" Value="{DynamicResource EditedAccentBrush}" />
  </Style>

  <Style Selector="Border.blockbox.moved">
    <Setter Property="BorderBrush" Value="{DynamicResource MovedAccentBrush}" />
  </Style>

  <Style Selector="Border.blockbox.conflict">
    <Setter Property="BorderBrush" Value="{DynamicResource ConflictAccentBrush}" />
  </Style>

  <!-- The in-place transfer arrow that pushes a block into the result.  -->
  <Style Selector="Button.transfer">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="2,0,1,0" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.transfer:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.transfer:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Border.cell.added">
    <Setter Property="Background" Value="{DynamicResource AddedBrush}" />
  </Style>

  <Style Selector="Border.cell.removed">
    <Setter Property="Background" Value="{DynamicResource RemovedBrush}" />
  </Style>

  <Style Selector="Border.cell.edited">
    <Setter Property="Background" Value="{DynamicResource EditedBrush}" />
  </Style>

  <Style Selector="Border.cell.moved">
    <Setter Property="Background" Value="{DynamicResource MovedBrush}" />
  </Style>

  <Style Selector="Border.cell.conflict">
    <Setter Property="Background" Value="{DynamicResource ConflictBrush}" />
  </Style>

  <Style Selector="Border.cell.empty">
    <Setter Property="Background" Value="{DynamicResource EmptyBrush}" />
  </Style>

  <!-- Intra-line token runs  -->
  <Style Selector="TextBlock.seg">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.seg.keyword">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxKeywordBrush}" />
  </Style>

  <Style Selector="TextBlock.seg.str">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxStringBrush}" />
  </Style>

  <Style Selector="TextBlock.seg.comment">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxCommentBrush}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <Style Selector="TextBlock.seg.number">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxNumberBrush}" />
  </Style>

  <Style Selector="TextBlock.seg.op">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxOperatorBrush}" />
  </Style>

  <Style Selector="Border.run">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Border.run.added">
    <Setter Property="Background" Value="{DynamicResource AddedStrongBrush}" />
  </Style>

  <Style Selector="Border.run.removed">
    <Setter Property="Background" Value="{DynamicResource RemovedStrongBrush}" />
  </Style>

  <!-- FR-044 high contrast: stronger fills and heavier markers for the same
       semantics, so the meaning never depends on a subtle tint.  -->
  <Style Selector="Window.highcontrast Border.cell.added">
    <Setter Property="Background" Value="{DynamicResource AddedStrongBrush}" />
  </Style>

  <Style Selector="Window.highcontrast Border.cell.removed">
    <Setter Property="Background" Value="{DynamicResource RemovedStrongBrush}" />
  </Style>

  <Style Selector="Window.highcontrast Border.cell.edited">
    <Setter Property="Background" Value="{DynamicResource EditedAccentBrush}" />
  </Style>

  <Style Selector="Window.highcontrast Border.cell.moved">
    <Setter Property="Background" Value="{DynamicResource MovedAccentBrush}" />
  </Style>

  <Style Selector="Window.highcontrast Border.cell.conflict">
    <Setter Property="Background" Value="{DynamicResource ConflictAccentBrush}" />
  </Style>

  <Style Selector="Window.highcontrast TextBlock.seg">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Markers  -->
  <Style Selector="TextBlock.marker">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <Style Selector="TextBlock.marker.added">
    <Setter Property="Foreground" Value="{DynamicResource AddedAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.marker.removed">
    <Setter Property="Foreground" Value="{DynamicResource RemovedAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.marker.edited">
    <Setter Property="Foreground" Value="{DynamicResource EditedAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.marker.moved">
    <Setter Property="Foreground" Value="{DynamicResource MovedAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.marker.conflict">
    <Setter Property="Foreground" Value="{DynamicResource ConflictAccentBrush}" />
  </Style>

  <Style Selector="Border.linegutter">
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="TextBlock.linenumber">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="Foreground" Value="{DynamicResource LineNumberBrush}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

</Styles>
